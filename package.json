    "shadcn": "^3.6.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "dotenv": "^16.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
